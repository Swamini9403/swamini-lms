# Copy to .env and change the secrets before deploying
APP_PORT=80
IMAGE_TAG=latest
BACKEND_IMAGE=swamini-lms-backend
FRONTEND_IMAGE=swamini-lms-frontend

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

MYSQL_DATABASE=lms
MYSQL_USER=lms_user
MYSQL_PASSWORD=lms_password
MYSQL_ROOT_PASSWORD=root_password
